# 1. 精度評価指標を計算する関数の定義
calc_metrics <- function(obs, pred) {
  valid <- complete.cases(obs, pred)
  obs   <- obs[valid]
  pred  <- pred[valid]
  
  if (length(obs) == 0) return(c(RMSE = NA, MAE = NA, R2 = NA, NSE = NA))
  
  rmse <- sqrt(mean((obs - pred)^2))
  mae  <- mean(abs(obs - pred))
  
  # 分散が 0 の場合の判定
  r2   <- ifelse(sd(obs) > 0 && sd(pred) > 0, cor(obs, pred)^2, NA)
  
  denom_nse <- sum((obs - mean(obs))^2)
  nse  <- ifelse(denom_nse > 0, 1 - (sum((obs - pred)^2) / denom_nse), NA)
  
  return(c(RMSE = rmse, MAE = mae, R2 = r2, NSE = nse))
}

