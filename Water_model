# =========================================================

# 1. 安定版のパラメータ推定関数を定義
estimate_parameters_stable <- function(df_weather, df_obs_smc, 
                                       fixed_a = 0.5, fixed_AWHC = 40.0,
                                       init_params = c(Sd = 200, SMC0 = 0.15)) {
  
  objective_func <- function(params) {
    Sd   <- params[1]
    SMC0 <- params[2]
    
    # 制約条件 (Sd: 50~500mm, SMC0: 0.0~0.4)
    if (Sd < 50 || Sd > 500 || SMC0 < 0 || SMC0 > 0.4) {
      return(1e9)
    }
    
    # 水収支シミュレーションの実行
    sim_res <- simulate_water(df_weather, a = fixed_a, AWHC = fixed_AWHC)
    sim_res$SMC_pred <- calc_SMC(sim_res$Aw, Sd = Sd, SMC0 = SMC0)
    
    # 日付で結合して残差を計算
    merged <- merge(df_obs_smc, sim_res, by = "date")
    if (nrow(merged) == 0) return(1e9)
    
    # 残差二乗和 (SSR)
    ssr <- sum((merged$SMC_obs - merged$SMC_pred)^2, na.rm = TRUE)
    return(ssr)
  }
  
  opt <- optim(par = init_params, fn = objective_func, method = "Nelder-Mead")
  names(opt$par) <- c("Sd", "SMC0")
  return(opt)
}


# 2. 全地点ループ処理の実行
# ※ 整形したデータフレーム名を df_obs_all と仮定しています
sites <- unique(df_obs_all$site)

results_list <- list()
summary_params <- data.frame()

# 固定値設定 (a=0.5, AWHC=40)
fixed_a    <- 0.5
fixed_AWHC <- 40.0

cat("解析を開始します（全", length(sites), "地点）...\n")

for (s in sites) {
  # 該当地点の抽出
  df_obs_site <- subset(df_obs_all, site == s)
  
  # 最適化の実行
  opt_out <- estimate_parameters_stable(
    df_weather  = df_weather, 
    df_obs_smc  = df_obs_site,
    fixed_a     = fixed_a,
    fixed_AWHC  = fixed_AWHC,
    init_params = c(Sd = 200, SMC0 = 0.05) # 初期値を少し低めに設定
  )
  
  pars <- opt_out$par
  
  # 結果の保存
  summary_params <- rbind(summary_params, data.frame(
    site = s,
    a    = fixed_a,
    AWHC = fixed_AWHC,
    Sd   = pars["Sd"],
    SMC0 = pars["SMC0"],
    SSR  = opt_out$value
  ))
  
  # 最適値でのシミュレーション結果を作成
  sim_site <- simulate_water(df_weather, a = fixed_a, AWHC = fixed_AWHC)
  sim_site$SMC_pred <- calc_SMC(sim_site$Aw, Sd = pars["Sd"], SMC0 = pars["SMC0"])
  sim_site$site <- s
  
  results_list[[s]] <- sim_site
}

