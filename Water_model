df_obs_all <- raw_df %>%
  # vwc_ で始まる日付列を1列にまとめる
  pivot_longer(
    cols = starts_with("vwc_"),
    names_to = "date_str",
    values_to = "vwc_pct"
  ) %>%
  mutate(
    # "vwc_0630" から "0630" を抽出して Year(2025) と結合 -> "2025-06-30" に変換
    date_clean = paste0(Year, "-", gsub("vwc_", "", date_str)),
    date       = as.Date(date_clean, format = "%Y-%m%d"),
    
    # %表記 (例: 7.6) を 体積比 (例: 0.076) に変換
    SMC_obs    = vwc_pct / 100,
    
    # name列をそのまま地点名 (site) として使用
    site       = name
  ) %>%
  # モデルに必要な列だけを抽出
  select(date, site, SMC_obs)

