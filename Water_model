# 3. 全地点ループで全日推定を実行
for (s in sites) {
  # 地点ごとの最適化パラメータを取得
  pars_target <- subset(summary_params, site == s)
  
  # 2025年通年で水収支シミュレーションを実行
  sim_full <- simulate_water(
    df_weather_2025_full, 
    a    = pars_target$a, 
    AWHC = pars_target$AWHC
  )
  
  # SMC（体積含水率）を計算
  sim_full$SMC_pred <- calc_SMC(
    sim_full$Aw, 
    Sd   = pars_target$Sd, 
    SMC0 = pars_target$SMC0
  )
  
  # 地点IDを列として追加
  sim_full$site <- s
  
  # 結果を結合 (必要な列だけ選択: date, site, rain, et_p, SMC_pred)
  sim_sub <- sim_full[, c("date", "site", "rain", "et_p", "SMC_pred")]
  df_pred_2025_all <- rbind(df_pred_2025_all, sim_sub)
}

