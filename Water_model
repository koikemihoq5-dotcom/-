# 1. 全天日射量 (GSR: MJ/m2/day) を推定する関数
calc_solar_rad <- function(doy, lat_deg, sunshine_hours) {
  phi <- lat_deg * pi / 180
  dr  <- 1 + 0.033 * cos(2 * pi * doy / 365)
  delta <- 0.409 * sin(2 * pi * doy / 365 - 1.39)
  
  ws <- acos(-tan(phi) * tan(delta))
  Gsc <- 0.0820
  Ra  <- (24 * 60 / pi) * Gsc * dr * (ws * sin(phi) * sin(delta) + cos(phi) * cos(delta) * sin(ws))
  
  N <- (24 / pi) * ws
  n_N <- sunshine_hours / N
  n_N <- pmin(pmax(n_N, 0), 1)  # 0〜1の範囲に収める
  
  Rs <- Ra * (0.25 + 0.50 * n_N)
  return(Rs)
}

# 2. データの整形と ETp 計算
# ※ 仙台周辺を想定して緯度 lat_deg = 38.26 としています（観測地に合わせて変更可）
lat_deg <- 38.26 

df_weather <- data_raw

# 日付形式の変換と通算日(doy)の作成
df_weather$date <- as.Date(df_weather$Date, format = "%Y/%m/%d")
df_weather$doy  <- as.numeric(format(df_weather$date, "%j"))

# 日照時間(Sun)から全天日射量(GSR)を推定
df_weather$GSR <- calc_solar_rad(
  doy            = df_weather$doy,
  lat_deg        = lat_deg,
  sunshine_hours = df_weather$Sun
)

# 気温(Temp)から飽和水蒸気圧曲線の斜率 s (kPa/℃) を計算
df_weather$s <- 4098 * (0.6108 * exp((17.27 * df_weather$Temp) / (df_weather$Temp + 237.3))) / 
                ((df_weather$Temp + 237.3)^2)

# 純放射量 Rn (mm/day) の算出 (GSRの約60%と仮定し水当量換算)
df_weather$Rn_mm <- (df_weather$GSR * 0.6) / 2.45

# Priestley-Taylor 式による ETp 計算
gamma <- 0.066
df_weather$et_p <- 1.26 * (df_weather$s / (df_weather$s + gamma)) * df_weather$Rn_mm

# モデルに必要な列（date, rain, et_p）だけに絞り込み
df_weather <- df_weather[, c("date", "Rain", "et_p")]
colnames(df_weather) <- c("date", "rain", "et_p")

