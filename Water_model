# 2. 安定版最適化関数の定義
estimate_parameters_stable <- function(df_weather, df_obs_smc, 
                                       fixed_a = 0.5, fixed_AWHC = 40.0,
                                       init_params = c(Sd = 200, SMC0 = 0.05)) {
  
  objective_func <- function(params) {
    Sd   <- params[1]
    SMC0 <- params[2]
    
    # 制約条件 (Sd: 50~500mm, SMC0: 0.0~0.4)
    if (Sd < 50 || Sd > 500 || SMC0 < 0 || SMC0 > 0.4) {
      return(1e9)
    }
    
    # 水収支シミュレーションの実行
    sim_res <- simulate_water(df_weather, a = fixed_a, AWHC = fixed_AWHC)
    sim_res$SMC_pred <- calc_SMC(sim_res$Aw, Sd = Sd, SMC0 = SMC0)
    
    # 日付で結合して残差を計算
    merged <- merge(df_obs_smc, sim_res, by = "date")
    if (nrow(merged) == 0) return(1e9)
    
    # 残差二乗和 (SSR)
    ssr <- sum((merged$SMC_obs - merged$SMC_pred)^2, na.rm = TRUE)
    return(ssr)
  }
  
  opt <- optim(par = init_params, fn = objective_func, method = "Nelder-Mead")
  names(opt$par) <- c("Sd", "SMC0")
  return(opt)
}

